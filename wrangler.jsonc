{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tckd-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
